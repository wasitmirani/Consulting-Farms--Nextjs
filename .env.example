# Copy to .env.local and fill in. Never commit .env.local.

# Public site URL (used for canonical URLs, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact overrides (optional — defaults are in lib/site.ts)
NEXT_PUBLIC_CONTACT_EMAIL=consultingfarms@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=+971554200786

# Lead emails via FREE SMTP.
# Option A — Gmail (free, ~500 emails/day): enable 2-Step Verification on the
# Google account, then create an
# App Password at https://myaccount.google.com/apppasswords and paste it below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=consultingfarms@gmail.com
SMTP_PASS=
LEAD_TO_EMAIL=consultingfarms@gmail.com
# Blind copy of every lead notification (comma-separate several addresses)
LEAD_BCC_EMAIL=
# Write emails to data/email-preview-*.html instead of sending (local testing only)
MAIL_PREVIEW=0
MAIL_FROM="Consulting Farms <consultingfarms@gmail.com>"

# Search engine verification (from Google Search Console / Bing Webmaster Tools)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Option B — Brevo free plan (300 emails/day, better deliverability for a custom domain):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=<your Brevo SMTP login>
# SMTP_PASS=<your Brevo SMTP key>

# Option C — Web3Forms (free, no SMTP needed; used automatically when SMTP_PASS is empty).
# Create a key at https://web3forms.com for each inbox that should receive leads.
# The free plan sends from the visitor's browser and has no CC, so a second key acts as BCC.
WEB3FORMS_ACCESS_KEY=
WEB3FORMS_BCC_ACCESS_KEY=
